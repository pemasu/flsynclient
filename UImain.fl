    } {
      Fl_Group {} {
        label General open
        xywh {0 25 470 335} box THIN_UP_BOX color 50 selection_color 50 labelfont 2 labelsize 11 align 5
      } {
        Fl_Choice TouchpadOff {
          label {Touchpad Mode}
          callback {synclient("TouchpadOff",o->value());}
          tooltip {Toggle the pad ON/OFF or only move (no scroll, tap, ecc.)} xywh {365 55 65 20} down_box FLAT_BOX color 50 selection_color 50 labelfont 2 labelsize 11
        } {
          MenuItem {} {
            label ON
            xywh {0 0 100 20} box NO_BOX color 50 selection_color 50 labelfont 2 labelsize 11
          }
          MenuItem {} {
