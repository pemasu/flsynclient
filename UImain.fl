            xywh {20 20 100 20} box NO_BOX color 50 selection_color 50 labelfont 2 labelsize 11
          }
          MenuItem {} {
            label {Top Right}
            xywh {30 30 100 20} box NO_BOX color 50 selection_color 50 labelfont 2 labelsize 11
          }
          MenuItem {} {
            label Right
            xywh {40 40 100 20} box NO_BOX color 50 selection_color 50 labelfont 2 labelsize 11
          }
          MenuItem {} {
            label {Bottom Right}
            xywh {30 30 100 20} box NO_BOX color 50 selection_color 50 labelfont 2 labelsize 11
          }
          MenuItem {} {
            label Bottom
            xywh {40 40 100 20} box NO_BOX color 50 selection_color 50 labelfont 2 labelsize 11
          }
          MenuItem {} {
            label {Bottom Left}
            xywh {50 50 100 20} box NO_BOX color 50 selection_color 50 labelfont 2 labelsize 11
          }
          MenuItem {} {
            label Left
            xywh {40 40 100 20} box NO_BOX color 50 selection_color 50 labelfont 2 labelsize 11
          }
          MenuItem {} {
            label {Top Left}
            xywh {50 50 100 20} box NO_BOX color 50 selection_color 50 labelfont 2 labelsize 11
          }
        }
        Fl_Value_Slider EdgeMotionMinSpeed {
          label {Edge Min Speed}
          callback {synclient("EdgeMotionMinSpeed",o->value());}
          tooltip {Slowest setting for edge motion speed} xywh {295 245 152 20} type Horizontal box THIN_DOWN_BOX color 50 selection_color 50 labelfont 2 labelsize 11 align 4 when 4
          code0 {o->precision(0);}
          code1 {o->range(0,300);}
        }
        Fl_Value_Slider EdgeMotionMaxSpeed {
          label {Edge Max Speed}
          callback {synclient("EdgeMotionMaxSpeed",o->value());}
          tooltip {Fastest setting for edge motion speed} xywh {295 271 152 19} type Horizontal box THIN_DOWN_BOX color 50 selection_color 50 labelfont 2 labelsize 11 align 4 when 4
          code0 {o->precision(0);}
          code1 {o->range(0,300);}
        }
        Fl_Value_Slider EdgeMotionMinMaxZ {
          label {Edge Sensitivity}
          callback {synclient("EdgeMotionMinZ",o->value());
synclient("EdgeMotionMaxZ",o->value()*2);}
          tooltip {Finger pressure for  motion speed} xywh {295 300 152 20} type Horizontal box THIN_DOWN_BOX color 50 selection_color 50 labelfont 2 labelsize 11 align 4 when 4
          code0 {o->precision(0);}
          code1 {o->range(1,150);}
        }
        Fl_Check_Button VertTwoScrolling {
          label {Two Finger Vertical Scroll}
          callback {synclient("VertTwoFingerScroll",o->value());}
          tooltip {Turns Two Finger Vertical Scrolling On} xywh {180 105 20 25} down_box DOWN_BOX color 50 labelfont 2 labelsize 11 align 4 hotspot
        }
        Fl_Check_Button HorizTwoScrolling {
          label {Two Finger Horizontal Scroll}
          callback {synclient("HorizTwoFingerScroll",o->value());}
          tooltip {Turns Two Finger Horizontal Scrolling On} xywh {180 130 20 25} down_box DOWN_BOX color 50 labelfont 2 labelsize 11 align 4 resizable hotspot
        }
        Fl_Check_Button CornerCoasting {
          label {Corner Coasting}
          callback {synclient("CornerCoasting",o->value());}
          tooltip {Enable edge scrolling to continue while the finger stays in an edge corner.} xywh {180 158 20 22} box FLAT_BOX down_box DOWN_BOX color 50 labelfont 2 labelsize 11 align 4
        }
        Fl_Value_Slider CoastingSpeed {
          label {Coasting Speed}
          callback {synclient("CoastingSpeed",o->value());}
          tooltip {Coasting threshold scrolling speed. 0 disables coasting.} xywh {40 210 152 20} type Horizontal box THIN_DOWN_BOX color 50 selection_color 50 labelfont 2 labelsize 11 align 5 when 4
        }
        Fl_Check_Button VertEdgeScroll {
          label {Vertical Edge Scroll}
          callback {synclient("VertEdgeScroll",o->value());}
          tooltip {Turns Vertical Edge Scrolling On} xywh {180 55 20 25} down_box DOWN_BOX color 50 labelfont 2 labelsize 11 align 4 hotspot
        }
        Fl_Check_Button HorizEdgeScroll {
          label {Horizontal Edge Scroll}
          callback {synclient("HorizEdgeScroll",o->value());}
          tooltip {Turns Horizontal Edge Scrolling On} xywh {180 80 20 25} down_box DOWN_BOX color 50 labelfont 2 labelsize 11 align 4 hotspot
        }
      }
    }
    Fl_Button {} {
      label Revert
      callback {RevertSettings(false);}
      tooltip {Reload last saved configuration} xywh {200 364 80 25} box THIN_UP_BOX color 50 selection_color 50 labelfont 2 labelsize 11
    }
    Fl_Button {} {
      label Save
      callback {SaveSettings();}
      tooltip {Save configuration to ~/.flSynclient} xywh {290 364 80 25} box THIN_UP_BOX color 50 selection_color 50 labelfont 2 labelsize 11
    }
    Fl_Button {} {
      label Quit
      callback {UImain->hide();}
      tooltip {Save configuration to ~/.flSynclient} xywh {380 364 80 25} box THIN_UP_BOX color 50 selection_color 50 labelfont 2 labelsize 11
    }
  }
  code {UImain->show();} {}
} 
